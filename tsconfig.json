{
  "compilerOptions": {
    "rootDir": "lib",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "inlineSourceMap": true
  },
  "include": ["lib"],
  "exclude": ["**/*.test.ts"]
}
