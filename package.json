  "bugs": {
    "url": "https://github.com/aantthony/equation/issues"
  },
  "homepage": "https://github.com/aantthony/equation#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
