# Cloudflare Workers assets header rules. Everything is otherwise served
# `max-age=0, must-revalidate`, so each hashed bundle costs a revalidation
# round trip on every page load.
#
# Vite content-hashes everything under /assets/, so a given URL's bytes can
# never change — a rebuild emits a new filename instead. That is exactly what
# `immutable` promises, so these can be cached for a year and skip the
# revalidation entirely. Nothing else is safe to pin this way: /, /about/ and
# the files in public/ keep their stable names across deploys.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
